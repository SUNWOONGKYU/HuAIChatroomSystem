# HU AI Chatroom Telegram Operation Env Template
# Copy values into your real secret manager or local runtime env. Do not commit real secrets.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_secret

# Legacy single-room selectors. Multi-room operation loads every active room from
# huai_rooms (status=eq.active) instead of pinning boot to one room, so these three
# are NOT required to boot bot-service/local-gateway anymore. Per-room chat id / owner
# id are supplied per onboarding call instead: node scripts/onboard-telegram-room.mjs
# --room-id <uuid> --chat-id <id> --owner-id <id> --project-path <path>
# Leave these unset in a real multi-room deployment. They still exist for: (1) local
# single-room dev/testing convenience, and (2) BOT_SERVICE_ROOM_ID/BOT_SERVICE_TELEGRAM_CHAT_ID
# also feed hasAnySupabaseRuntimeEnv()'s Supabase-vs-local mode detection, though
# SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY alone already satisfy that check.
# BOT_SERVICE_ROOM_ID=00000000-0000-4000-8000-000000000000
# BOT_SERVICE_TELEGRAM_CHAT_ID=-1000000000000
# BOT_SERVICE_OWNER_TELEGRAM_USER_ID=1000000000

# "작업판 열기" 버튼(Direct Link Mini App, t.me/<bot>/<app>?startapp=<roomId>)의 베이스
# 링크. 미설정이면 /tasks 응답에 버튼을 안 붙인다(기존 동작 그대로) — Mini App 이 아직
# BotFather 에 등록 안 됐거나 배포 전인 환경에서는 비워 두면 된다. 값은 https://t.me/
# 로 시작해야 한다(그래야 그룹 채팅에서도 Mini App 으로 열린다 — web_app 타입 인라인
# 버튼은 Telegram 공식 문서상 사설 채팅 전용이라 그룹에서 안 눌린다).
# BOT_SERVICE_MINIAPP_DIRECT_LINK=https://t.me/your_platoon_bot/board
BOT_SERVICE_PUBLIC_BASE_URL=https://your-public-bot-service.example.com
BOT_SERVICE_LISTEN_HOST=127.0.0.1
BOT_SERVICE_LISTEN_PORT=8787
BOT_SERVICE_OUTBOX_ENABLED=true
BOT_SERVICE_OUTBOX_LIMIT=10
BOT_SERVICE_OUTBOX_LEASE_MS=60000
BOT_SERVICE_OUTBOX_POLL_MS=3000
BOT_SERVICE_OUTBOX_MAX_ATTEMPTS=5

BOT_SERVICE_PLATOON_BOT_USERNAME=your_platoon_bot
BOT_SERVICE_CLAUDE_BOT_USERNAME=your_claude_bot
BOT_SERVICE_CODEX_BOT_USERNAME=your_codex_bot
BOT_SERVICE_AUDITOR_BOT_USERNAME=your_auditor_bot

BOT_SERVICE_PLATOON_BOT_TOKEN=replace_with_platoon_bot_token
BOT_SERVICE_CLAUDE_BOT_TOKEN=replace_with_claude_bot_token
BOT_SERVICE_CODEX_BOT_TOKEN=replace_with_codex_bot_token
BOT_SERVICE_AUDITOR_BOT_TOKEN=replace_with_auditor_bot_token

BOT_SERVICE_PLATOON_WEBHOOK_SECRET=replace_with_platoon_webhook_secret
BOT_SERVICE_CLAUDE_WEBHOOK_SECRET=replace_with_claude_webhook_secret
BOT_SERVICE_CODEX_WEBHOOK_SECRET=replace_with_codex_webhook_secret
BOT_SERVICE_AUDITOR_WEBHOOK_SECRET=replace_with_auditor_webhook_secret

# Fallback only, DB wins. Each room's gateway/project path normally comes from that
# room's own row in Supabase huai_gateway_instances (set by onboard-telegram-room.mjs /
# generate-supabase-room-seed.mjs when the room is onboarded). These two env vars are
# used ONLY when a room has no huai_gateway_instances data yet — they do NOT override
# a room that already has DB data. Do not rely on these to route a specific room to a
# specific folder in a multi-room deployment; that must come from the DB per room, or
# every room without its own gateway row would silently share the same fallback path.
# BOT_SERVICE_EXECUTION_GATEWAY_ID=primary
# BOT_SERVICE_EXECUTION_PROJECT_PATH=C:\Dev\HuAIChatroomSystem
BOT_SERVICE_EXECUTION_ACTOR_ROLE=codex_leader
BOT_SERVICE_EXECUTION_TIMEOUT_MS=900000

# Multi-room note: this local-gateway process may serve many rooms from one machine.
# List every project folder this machine is allowed to execute in (semicolon- or
# comma-separated) — one entry per room's project path, not just the first room's.
# A room's actual execution path still comes from its own huai_gateway_instances row;
# this is the machine-wide allowlist local-gateway enforces requests against.
# huai_gateway_instances.room_id is NOT NULL, so a gateway row belongs to exactly one
# room — one machine serving 20 rooms needs 20 gateway rows (same machine_label), not
# one. onboard-telegram-room.mjs / generate-supabase-room-seed.mjs create these rows;
# this env var does not substitute for them.
LOCAL_GATEWAY_ALLOWED_ROOTS=C:\Dev\HuAIChatroomSystem
LOCAL_GATEWAY_ALLOWED_ADAPTERS=codex,claude_code,antigravity
# NOTE: the poll interval env var is LOCAL_GATEWAY_INTERVAL_MS, not
# LOCAL_GATEWAY_POLL_MS. runtime.ts only reads LOCAL_GATEWAY_INTERVAL_MS — a
# LOCAL_GATEWAY_POLL_MS entry anywhere in your real env is silently ignored (confirmed
# by reading apps/local-gateway/src/runtime.ts; this is not a guess). If you see
# LOCAL_GATEWAY_POLL_MS in a real .env file, it does nothing — remove it or rename it.
LOCAL_GATEWAY_INTERVAL_MS=5000
LOCAL_GATEWAY_LIMIT=5
LOCAL_GATEWAY_MAX_ATTEMPTS=3
# LOCAL_GATEWAY_CONCURRENCY/LOCAL_GATEWAY_LEASE_MS must be changed together. runtime.ts
# rejects boot unless: LEASE_MS > MAX_RUNTIME_MS * ceil(LIMIT / CONCURRENCY). With the
# values below (LIMIT=5, MAX_RUNTIME_MS=900000): CONCURRENCY=3 needs LEASE_MS > 1800000
# (this file uses 1860000, a 60s margin — confirmed against the live restart config in
# scripts/restart-local-gateway-live.mjs and verified directly against
# parseLocalGatewayRuntimeConfig()). If you lower CONCURRENCY to 2, the required LEASE_MS
# jumps to > 2700000 (ceil(5/2)=3); lowering to 1 needs > 4500000 (ceil(5/1)=5). Lowering
# CONCURRENCY without raising LEASE_MS to match makes local-gateway refuse to boot at
# all — it fails loud (better than silently double-executing a still-running row), but
# the failure reads as "gateway won't start" with no obvious link to the concurrency
# change unless you know this formula.
LOCAL_GATEWAY_CONCURRENCY=3
LOCAL_GATEWAY_LEASE_MS=1860000
LOCAL_GATEWAY_MAX_RUNTIME_MS=900000
LOCAL_GATEWAY_MAX_CONSECUTIVE_ERRORS=5
LOCAL_GATEWAY_ALLOW_NETWORK=false
LOCAL_GATEWAY_HEALTH_PORT=8797
# 방을 여러 개 운영할 때, 방마다 게이트웨이 프로세스를 하나씩 띄운다.
# 형식: 라벨|gatewayId|건강검진포트|작업폴더 (여러 개는 세미콜론으로 구분)
#
# 게이트웨이는 자기 gateway_id 로 온 일만 리스하고 자기 allowed roots 안에서만 실행하므로,
# 한 프로세스가 여러 방을 맡을 수 없다. 위 LOCAL_GATEWAY_ID 로 뜨는 기본 게이트웨이는
# 그대로 두고, 방이 늘어난 만큼 여기에 줄을 더한다. 포트는 서로 겹치면 안 된다.
# LOCAL_GATEWAY_EXTRA_INSTANCES=roomA|<gateway-uuid>|8798|C:\Work\roomA;roomB|<gateway-uuid>|8799|C:\Work\roomB
HUAI_AUTO_AUDIT_ENABLED=true
