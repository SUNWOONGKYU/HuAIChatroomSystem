# HU AI Chatroom Telegram Operation Env Template
# Copy values into your real secret manager or local runtime env. Do not commit real secrets.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_secret
# SUPABASE_SERVICE_KEY 로 적어도 동작한다 — scripts/operation-env-loader.mjs 의
# applyOperationEnvAliases() 가 SUPABASE_SERVICE_ROLE_KEY 가 비어 있을 때만 이 값을
# 그리로 복사한다(둘 다 있으면 SUPABASE_SERVICE_ROLE_KEY 가 우선). 새 이름을 쓰는 게 낫다 —
# 이 별칭은 과거 표기와의 호환을 위해서만 남아 있다.

# Legacy single-room selectors. Multi-room operation loads every active room from
# huai_rooms (status=eq.active) instead of pinning boot to one room, so these three
# are NOT required to boot bot-service/local-gateway anymore. Per-room chat id / owner
# id are supplied per onboarding call instead: node scripts/onboard-telegram-room.mjs
# --room-id <uuid> --chat-id <id> --owner-id <id> --project-path <path>
# Leave these unset in a real multi-room deployment. They still exist for: (1) local
# single-room dev/testing convenience, and (2) BOT_SERVICE_ROOM_ID/BOT_SERVICE_TELEGRAM_CHAT_ID
# also feed hasAnySupabaseRuntimeEnv()'s Supabase-vs-local mode detection, though
# SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY alone already satisfy that check.
# BOT_SERVICE_ROOM_ID=00000000-0000-4000-8000-000000000000
# BOT_SERVICE_TELEGRAM_CHAT_ID=-1000000000000
# BOT_SERVICE_OWNER_TELEGRAM_USER_ID=1000000000
# CSV plural form of BOT_SERVICE_TELEGRAM_CHAT_ID for local mode (buildLocalBotServiceConfig /
# buildLocalInboundProcessorPorts in apps/bot-service/src/local-runtime.ts) — every id in this
# list is treated as owned by BOT_SERVICE_OWNER_TELEGRAM_USER_ID. Same "not needed once Supabase
# multi-room is live" caveat as the three vars above.
# BOT_SERVICE_ALLOWED_CHAT_IDS=-1000000000000,-1000000000001

# "작업판 열기" 버튼(Direct Link Mini App, t.me/<bot>/<app>?startapp=<roomId>)의 베이스
# 링크. 미설정이면 /tasks 응답에 버튼을 안 붙인다(기존 동작 그대로) — Mini App 이 아직
# BotFather 에 등록 안 됐거나 배포 전인 환경에서는 비워 두면 된다. 값은 https://t.me/
# 로 시작해야 한다(그래야 그룹 채팅에서도 Mini App 으로 열린다 — web_app 타입 인라인
# 버튼은 Telegram 공식 문서상 사설 채팅 전용이라 그룹에서 안 눌린다).
# BOT_SERVICE_MINIAPP_DIRECT_LINK=https://t.me/your_leader_bot/board

# Telegram 수신 방식. 코드 자체의 기본값(이 값을 아예 비우거나 webhook으로 두면)은
# webhook이지만, 이 운영 템플릿은 polling으로 채워서 배포한다 — 공개 HTTPS 주소·터널·
# 인증서 관리가 필요 없다. webhook으로 바꾸려면 이 값을 webhook으로 바꾸고
# BOT_SERVICE_PUBLIC_BASE_URL을 실제 공개 주소로 채운다(GITHUB_QUICKSTART.md 5단계 참고).
BOT_SERVICE_RECEIVE_MODE=polling
BOT_SERVICE_PUBLIC_BASE_URL=https://your-public-bot-service.example.com
# NOTE: the listen port env var is BOT_SERVICE_PORT, not BOT_SERVICE_LISTEN_PORT — this file
# used to document BOT_SERVICE_LISTEN_PORT/BOT_SERVICE_LISTEN_HOST, but server.ts only ever reads
# BOT_SERVICE_PORT (confirmed in apps/bot-service/src/server.ts), and the listen host is hardcoded
# to 127.0.0.1 (not configurable at all — there is no listen-host env var). The two old names did
# nothing; if you have them in a real env file, remove them and use BOT_SERVICE_PORT instead.
BOT_SERVICE_PORT=8787
# HTTP 서버가 큐에 쌓인 인바운드 입력을 얼마 간격으로 비우는지(ms). server.ts 기본값 100.
BOT_SERVICE_INBOUND_POLL_MS=100
BOT_SERVICE_OUTBOX_ENABLED=true
BOT_SERVICE_OUTBOX_LIMIT=10
# 아래 두 줄은 이 파일의 다른 값들과 달리 코드 기본값을 그대로 옮기지 않았다 — 의도적
# 운영 튜닝값이다. server.ts 기본값은 LEASE_MS=30000/POLL_MS=250(더 촘촘한 폴링)이지만,
# 이 템플릿은 단일 운영자 PC가 Supabase를 필요 이상으로 자주 두드리지 않도록 리스를
# 늘리고(60초) 폴링을 늦춘다(3초). 메시지가 몇 초 늦게 나가도 되는 배포에서만 그대로 두고,
# 초 단위 응답성이 중요하면 코드 기본값(LEASE_MS=30000/POLL_MS=250)으로 낮춰도 된다.
BOT_SERVICE_OUTBOX_LEASE_MS=60000
BOT_SERVICE_OUTBOX_POLL_MS=3000
BOT_SERVICE_OUTBOX_MAX_ATTEMPTS=5
# 아웃박스 발송기. 비우거나 다른 값이면 grammy 클라이언트(기본), "fetch"면 순수 fetch 기반
# 발송기를 쓴다(createTelegramFetchSender, server.ts). 보통 안 건드려도 된다.
# BOT_SERVICE_TELEGRAM_SENDER=fetch

BOT_SERVICE_LEADER_BOT_USERNAME=your_leader_bot
BOT_SERVICE_CLAUDE_BOT_USERNAME=your_claude_bot
BOT_SERVICE_CODEX_BOT_USERNAME=your_codex_bot
BOT_SERVICE_AUDITOR_BOT_USERNAME=your_auditor_bot

BOT_SERVICE_LEADER_BOT_TOKEN=replace_with_leader_bot_token
BOT_SERVICE_CLAUDE_BOT_TOKEN=replace_with_claude_bot_token
BOT_SERVICE_CODEX_BOT_TOKEN=replace_with_codex_bot_token
BOT_SERVICE_AUDITOR_BOT_TOKEN=replace_with_auditor_bot_token

BOT_SERVICE_LEADER_WEBHOOK_SECRET=replace_with_leader_webhook_secret
BOT_SERVICE_CLAUDE_WEBHOOK_SECRET=replace_with_claude_webhook_secret
BOT_SERVICE_CODEX_WEBHOOK_SECRET=replace_with_codex_webhook_secret
BOT_SERVICE_AUDITOR_WEBHOOK_SECRET=replace_with_auditor_webhook_secret

# 위 4개 USERNAME/TOKEN/WEBHOOK_SECRET 쌍은 로컬(비-Supabase) 모드 기본 배선이다. 아래 둘은
# 그 배선 자체를 갈아끼우는 고급 오버라이드이고, 보통 필요 없다:
# - BOT_SERVICE_BOTS_JSON: 위 개별 USERNAME/BOT_ID/WEBHOOK_SECRET 대신 봇 배열 전체를 JSON으로
#   직접 준다(local-runtime.ts parseBotRuntimeConfigs). 있으면 위 값들을 무시한다.
# - BOT_SERVICE_BOT_TOKEN_SECRET_REFS_JSON: role→토큰 조회 방식을 바꾼다. 기본은 각 역할을
#   env:BOT_SERVICE_<ROLE>_BOT_TOKEN 으로 조회한다(bot-token-resolver.ts
#   DEFAULT_TELEGRAM_BOT_TOKEN_SECRET_REFS). 다른 시크릿 매니저 참조 스킴을 쓸 때만 채운다.
# BOT_SERVICE_BOTS_JSON={"leader":{...}}
# BOT_SERVICE_BOT_TOKEN_SECRET_REFS_JSON={"leader":"env:BOT_SERVICE_LEADER_BOT_TOKEN"}

# Fallback only, DB wins. Each room's gateway/project path normally comes from that
# room's own row in Supabase huai_gateway_instances (set by onboard-telegram-room.mjs /
# generate-supabase-room-seed.mjs when the room is onboarded). These two env vars are
# used ONLY when a room has no huai_gateway_instances data yet — they do NOT override
# a room that already has DB data. Do not rely on these to route a specific room to a
# specific folder in a multi-room deployment; that must come from the DB per room, or
# every room without its own gateway row would silently share the same fallback path.
# BOT_SERVICE_EXECUTION_GATEWAY_ID=primary
# BOT_SERVICE_EXECUTION_PROJECT_PATH=<YOUR_PROJECT_ROOT>
BOT_SERVICE_EXECUTION_ACTOR_ROLE=codex_leader
BOT_SERVICE_EXECUTION_TIMEOUT_MS=900000

# 실행 중 표시(Telegram "입력 중…")를 몇 ms마다 다시 보낼지. Telegram 쪽 표시가 약 5초 뒤
# 사라지므로 그보다 짧아야 한다(server.ts 기본값 4000). "false"로 끄면 하트비트 자체를 안 켠다.
BOT_SERVICE_EXECUTION_HEARTBEAT_ENABLED=true
BOT_SERVICE_EXECUTION_HEARTBEAT_MS=4000

# /readyz(8787) 판정: polling 모드에서 마지막 성공 폴링이 이 시간(ms)을 넘으면 폴링이 멈춘
# 것으로 보고 503을 낸다(readiness.ts checkReceivePath). 기본 120000(2분).
BOT_SERVICE_READYZ_POLL_STALE_MS=120000

# 결정되지 않고 쌓인 제안을 주기적으로 정리한다(stale-proposal-cleanup.ts) — 방장이 응답
# 안 한 제안이 무한정 쌓이는 결함 대응. SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY 가 없으면
# (로컬 모드) 값과 무관하게 자동으로 꺼진다. "false"로 명시해야 끌 수 있다(기본 켜짐).
# 기본 주기 3600000(1시간).
BOT_SERVICE_STALE_PROPOSAL_CLEANUP_ENABLED=true
BOT_SERVICE_STALE_PROPOSAL_CLEANUP_MS=3600000

# 방 단위 복구 스냅샷을 주기적으로 만든다(room-backup-scheduler.ts → room-backup.ts).
# huai_recovery_snapshots 에 snapshot_type='room' 으로 장부를 남기고 스냅샷 본문은
# sessions/rooms/recovery/<roomId>/ 아래에 떨어진다. 위 stale 정리와 같은 원칙 —
# SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY 가 없으면(로컬 모드) 값과 무관하게 자동으로 꺼지고,
# "false"로 명시해야 끌 수 있다(기본 켜짐). 기본 주기 21600000(6시간).
# 수동 실행은 npm run backup:rooms (특정 방만: -- --room <roomId>, 예행연습: -- --dry-run).
BOT_SERVICE_ROOM_BACKUP_ENABLED=true
BOT_SERVICE_ROOM_BACKUP_MS=21600000

# 방 하나당 보관할 룸 백업 스냅샷 파일의 최대 개수(room-backup.ts
# maxSnapshotsPerRoomFromEnv). 초과분은 오래된 것부터 자동 삭제된다(사람 승인 없이 —
# 스냅샷은 로그 회전처럼 더 새 스냅샷이 항상 뒤이어 남으므로 안전하다고 판단). 기본
# 240 = 6시간 간격 x 하루 4회 x 60일로, prune-archived-rows.mjs 의 HUAI_RETENTION_DAYS
# 기본 60일과 맞춘 값이다. 0 이하이거나 숫자가 아니면 기본값 240 으로 되돌아간다.
# HUAI_ROOM_BACKUP_MAX_SNAPSHOTS=240

# Mini App(협업 운영센터)에서 내려진 승인/보완 요청 결정을 얼마 간격·몇 건씩 읽어올지
# (miniapp-decision-poller.ts). "false"로 끄면 폴러 자체가 안 뜬다. 기본 20건/3000ms.
BOT_SERVICE_MINIAPP_POLL_ENABLED=true
BOT_SERVICE_MINIAPP_POLL_LIMIT=20
BOT_SERVICE_MINIAPP_POLL_MS=3000

# polling 모드에서 사진/문서 첨부를 실제로 내려받아 저장할 폴더(방마다 하위 폴더는 chat id).
# 비우면 기본값 C:\tmp\huai-telegram-attachments 를 쓴다(polling.ts).
# BOT_SERVICE_ATTACHMENTS_DIR=C:\tmp\huai-telegram-attachments

# REQUIRED to boot local-gateway in Supabase mode (requiredEnv in supabase-store.ts — process
# exits if unset). This machine's own gateway row id from huai_gateway_instances.gateway_id —
# a gateway only leases outbox rows addressed to its own gateway_id, so this is what stops two
# gateways on different machines from grabbing the same room's work. onboard-telegram-room.mjs
# prints `gateway_id=<uuid>` at the end of a successful onboarding run; copy that value here
# (this was undocumented in this file before — do not guess a UUID, use the one that command
# printed, or the one already stored in huai_gateway_instances for this machine/room).
LOCAL_GATEWAY_ID=00000000-0000-4000-8000-000000000000

# Multi-room note: this local-gateway process may serve many rooms from one machine.
# List every project folder this machine is allowed to execute in (semicolon- or
# comma-separated) — one entry per room's project path, not just the first room's.
# A room's actual execution path still comes from its own huai_gateway_instances row;
# this is the machine-wide allowlist local-gateway enforces requests against.
# huai_gateway_instances.room_id is NOT NULL, so a gateway row belongs to exactly one
# room — one machine serving 20 rooms needs 20 gateway rows (same machine_label), not
# one. onboard-telegram-room.mjs / generate-supabase-room-seed.mjs create these rows;
# this env var does not substitute for them.
LOCAL_GATEWAY_ALLOWED_ROOTS=<YOUR_PROJECT_ROOT>
LOCAL_GATEWAY_ALLOWED_ADAPTERS=codex,claude_code,gemini_web,antigravity
# Gemini 웹 실행기는 전용 Chrome CDP(9222)와 기존 로그인 세션을 재사용한다.
# 비밀번호·2FA는 자동 입력하지 않는다. antigravity 레거시 행도 같은 Gemini 경로로 간다.
#
# 아래 넷은 모두 선택 항목이다 — 비워 두면 코드가 스스로 찾는다.
# - GEMINI_WEB_SESSION_SCRIPT: 웹세션-자동화 스킬의 session.js. 기본값은
#   <홈 디렉터리>\.codex\skills\웹세션-자동화\session.js (scripts/gemini-web-adapter.mjs).
# - GEMINI_WEB_CHAT_URL: 특정 Gemini 대화 URL 로 고정하고 싶을 때. 비우면 새 대화.
# - GEMINI_WEB_BRIDGE_ENTRYPOINT: 브리지 스크립트 위치를 바꿀 때. 기본값은 이 저장소의
#   scripts/gemini-web-adapter.mjs 를 dist 위치에서 거슬러 올라가 찾는다 (packages/ai-adapters).
# - GEMINI_WEB_CDP_URL: operation-status-report.mjs 가 Gemini 자동화 Chrome 이 떠 있는지 볼 때
#   찌르는 CDP 주소. 비우면 http://127.0.0.1:9222/json/version (기본 CDP 포트 9222).
# GEMINI_WEB_SESSION_SCRIPT=<YOUR_HOME>\.codex\skills\웹세션-자동화\session.js
# GEMINI_WEB_CHAT_URL=https://gemini.google.com/app/<conversation-id>
# GEMINI_WEB_BRIDGE_ENTRYPOINT=<YOUR_PROJECT_ROOT>\scripts\gemini-web-adapter.mjs
# GEMINI_WEB_CDP_URL=http://127.0.0.1:9222/json/version
# 실행이 만든 .html 을 올려 폰에서 열 수 있게 한다. 비우면 올리지 않는다(로컬 경로만 남음).
LOCAL_GATEWAY_ARTIFACT_VERCEL_PROJECT=huai-artifacts
# 산출물을 Vercel 에 올리는 vercel deploy/promote 자식 프로세스가 멈췄을 때(토큰 만료 인터랙티브
# 프롬프트, 네트워크 블랙홀) 강제 종료할 때까지 기다리는 시간(ms). artifact-publisher.ts
# 기본값 — deploy 180000(3분), promote 90000(1분30초). 게이트웨이 동시성이 낮을 때(기본
# CONCURRENCY=3) 이 한 건이 멈추면 그 시간만큼 다른 방 작업도 밀리므로, 네트워크가 느린
# 환경이 아니라면 기본값을 늘리기보다 원인(토큰 재로그인 등)을 먼저 본다.
LOCAL_GATEWAY_ARTIFACT_DEPLOY_TIMEOUT_MS=180000
LOCAL_GATEWAY_ARTIFACT_PROMOTE_TIMEOUT_MS=90000
# 산출물 스크린샷 캡처(Playwright) 기본 켜짐 — chromium 이 없는 머신에서만 "false"로 끈다.
# LOCAL_GATEWAY_SCREENSHOT_ENABLED=false
# NOTE: the poll interval env var is LOCAL_GATEWAY_INTERVAL_MS, not
# LOCAL_GATEWAY_POLL_MS. runtime.ts only reads LOCAL_GATEWAY_INTERVAL_MS — a
# LOCAL_GATEWAY_POLL_MS entry anywhere in your real env is silently ignored (confirmed
# by reading apps/local-gateway/src/runtime.ts; this is not a guess). If you see
# LOCAL_GATEWAY_POLL_MS in a real .env file, it does nothing — remove it or rename it.
LOCAL_GATEWAY_INTERVAL_MS=5000
LOCAL_GATEWAY_LIMIT=5
LOCAL_GATEWAY_MAX_ATTEMPTS=3
# LOCAL_GATEWAY_CONCURRENCY/LOCAL_GATEWAY_LEASE_MS must be changed together. runtime.ts
# rejects boot unless: LEASE_MS > MAX_RUNTIME_MS * ceil(LIMIT / CONCURRENCY). With the
# values below (LIMIT=5, MAX_RUNTIME_MS=900000): CONCURRENCY=3 needs LEASE_MS > 1800000
# (this file uses 1860000, a 60s margin — confirmed against the live restart config in
# scripts/restart-local-gateway-live.mjs and verified directly against
# parseLocalGatewayRuntimeConfig()). If you lower CONCURRENCY to 2, the required LEASE_MS
# jumps to > 2700000 (ceil(5/2)=3); lowering to 1 needs > 4500000 (ceil(5/1)=5). Lowering
# CONCURRENCY without raising LEASE_MS to match makes local-gateway refuse to boot at
# all — it fails loud (better than silently double-executing a still-running row), but
# the failure reads as "gateway won't start" with no obvious link to the concurrency
# change unless you know this formula.
LOCAL_GATEWAY_CONCURRENCY=3
LOCAL_GATEWAY_LEASE_MS=1860000
# runtime.ts 코드 기본값은 1800000(30분)이다. 이 템플릿은 의도적으로 900000(15분)을
# 쓴다 — GITHUB_QUICKSTART.md "운영 기본 실행 제한은 15분입니다"와 맞추기 위해서이고,
# BOT_SERVICE_EXECUTION_TIMEOUT_MS(위, 900000)와도 같은 값이어야 한 실행이 봇 쪽에서
# 먼저 타임아웃되고 게이트웨이 쪽이 뒤늦게 타임아웃되는 어긋남이 없다. 이 값을 바꾸면
# 위 LOCAL_GATEWAY_LEASE_MS 공식(LEASE_MS > MAX_RUNTIME_MS * ceil(LIMIT/CONCURRENCY))도
# 같이 다시 계산해야 한다.
LOCAL_GATEWAY_MAX_RUNTIME_MS=900000
LOCAL_GATEWAY_MAX_CONSECUTIVE_ERRORS=5
LOCAL_GATEWAY_ALLOW_NETWORK=false
LOCAL_GATEWAY_HEALTH_PORT=8797
# 방을 여러 개 운영할 때, 방마다 게이트웨이 프로세스를 하나씩 띄운다.
# 형식: 라벨|gatewayId|건강검진포트|작업폴더 (여러 개는 세미콜론으로 구분)
#
# 게이트웨이는 자기 gateway_id 로 온 일만 리스하고 자기 allowed roots 안에서만 실행하므로,
# 한 프로세스가 여러 방을 맡을 수 없다. 위 LOCAL_GATEWAY_ID 로 뜨는 기본 게이트웨이는
# 그대로 두고, 방이 늘어난 만큼 여기에 줄을 더한다. 포트는 서로 겹치면 안 된다.
# LOCAL_GATEWAY_EXTRA_INSTANCES=roomA|<gateway-uuid>|8798|C:\Work\roomA;roomB|<gateway-uuid>|8799|C:\Work\roomB
HUAI_AUTO_AUDIT_ENABLED=true

# 작업 현황판 페이지를 올릴 Vercel 프로젝트. 빌드가 dist 를 지우면서 vercel 연결 정보까지
# 날리므로, 여기 값으로 매번 다시 박는다 — 없으면 폴더 이름으로 새 프로젝트가 생긴다.
VERCEL_BOARD_PROJECT_ID=prj_9mHviOqO7gzSW4Aca75hf8n41KJ8
VERCEL_BOARD_ORG_ID=team_FawbxqCQiznT1C5BMaOOsmGz

# 감독 스크립트(start-services.mjs, restart-operation-services-from-live-env.mjs)가 append
# 모드로 여는 로그 파일의 회전 설정(scripts/log-rotation.mjs). copytruncate 방식 — 열려 있는
# fd 를 죽이지 않는다. 기본 20MB(HUAI_LOG_MAX_BYTES), 백업 5개(HUAI_LOG_MAX_BACKUPS, .1~.5).
# HUAI_LOG_MAX_BYTES=20971520
# HUAI_LOG_MAX_BACKUPS=5

# Telegram 방/Mini App 미리보기에서 긴 메시지를 자르는 글자 수. 기본 300
# (message-rendering.ts DEFAULT_ROOM_MESSAGE_PREVIEW_CHARS). 이보다 긴 보고는 "전문 보기"
# 버튼으로 huai_task_reports 전문을 연다.
# HUAI_ROOM_MESSAGE_PREVIEW_CHARS=300

# 상태/스모크 스크립트가 헬스체크를 찌를 주소 오버라이드(operation-status-report.mjs,
# live-formal-smoke.mjs). 기본은 이 파일의 BOT_SERVICE_PORT(8787)/LOCAL_GATEWAY_HEALTH_PORT
# (8797)와 이미 일치하므로, 그 값들을 그대로 쓰면 건드릴 필요 없다 — 리버스 프록시 뒤에
# 두는 등 실제 헬스체크 주소가 달라질 때만 채운다.
# BOT_SERVICE_HEALTH_URL=http://127.0.0.1:8787/healthz
# LOCAL_GATEWAY_HEALTH_URL=http://127.0.0.1:8797/healthz

# ── 아래는 상주 서비스(bot-service/local-gateway) 기동에는 쓰이지 않는, 운영자가 수동으로
# 돌리는 유지보수 스크립트 전용 변수다. start-operation-services.mjs 가 이 파일을 로드해도
# 상주 서비스 동작에는 영향이 없다. 각 스크립트를 실행하는 셸에 이 값들이 있으면 읽는다. ──

# scripts/archive-room-conversations.mjs, scripts/distill-room-memory.mjs 가 방 대화 원본을
# 매일 로컬에 저장하는 폴더. 기본 sessions/rooms.
# HUAI_ARCHIVE_LOCAL_DIR=sessions/rooms
# scripts/prune-archived-rows.mjs — 이 일수보다 오래된 통신 기록만 정리한다(작업·승인·
# 산출물·보고 전문은 나이와 무관하게 보존). 기본 60일.
# HUAI_RETENTION_DAYS=60
# scripts/distill-room-memory.mjs 가 하루치 대화를 요약할 때 쓰는 모델. 기본 claude-sonnet-4-6.
# HUAI_MEMORY_MODEL=claude-sonnet-4-6
# scripts/discover-telegram-ids.mjs — getUpdates 로 chat/user id 를 찾을 때 쓸 봇 역할
# (LEADER/CLAUDE/CODEX/AUDITOR). 기본 LEADER.
# DISCOVER_TELEGRAM_ROLE=LEADER
# scripts/restart-operation-services-from-live-env.mjs 가 재시작 시 BOT_SERVICE_EXECUTION_TIMEOUT_MS
# 와 LOCAL_GATEWAY_MAX_RUNTIME_MS 둘 다에 이 값을 덮어쓴다. 기본 900000(15분) — 위의 개별
# EXECUTION_TIMEOUT_MS/MAX_RUNTIME_MS 값과 다르게 두면 재시작 스크립트를 쓸 때 이 값이 이긴다.
# HUAI_OPERATION_RUNTIME_MS=900000
# scripts/verify-operation-ready.mjs 의 Gate 하나당 최대 대기시간(ms). 비우면 타임아웃 없음
# (무제한 대기). 느리거나 멈춘 Gate를 찾을 때만 값을 넣어 쓴다(INCIDENT_RUNBOOK
# "Full Operation Dry Run" 참고 — 예시값 120000).
# OPERATION_READY_STEP_TIMEOUT_MS=120000
# start-operation-services.mjs 가 기본 .env.operation.local 대신 읽을 env 파일 경로.
# OPERATION_ENV_FILE=.env.operation.local
# scripts/build-miniapp-web.mjs 가 Mini App 정적 파일의 Supabase Functions 베이스 URL
# 자리표시자(__MINIAPP_FUNCTIONS_BASE_URL__)를 채울 값. 비우면 SUPABASE_URL 에서 유도한다
# (<project-ref>.functions.supabase.co). Functions 를 별도 프로젝트에 둘 때만 채운다.
# MINIAPP_FUNCTIONS_BASE_URL=https://your-project.functions.supabase.co
