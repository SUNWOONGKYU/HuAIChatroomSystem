# HU AI Chatroom Telegram Operation Env Template
# Copy values into your real secret manager or local runtime env. Do not commit real secrets.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_secret

BOT_SERVICE_ROOM_ID=00000000-0000-4000-8000-000000000000
BOT_SERVICE_TELEGRAM_CHAT_ID=-1000000000000
BOT_SERVICE_OWNER_TELEGRAM_USER_ID=1000000000
BOT_SERVICE_PUBLIC_BASE_URL=https://your-public-bot-service.example.com
BOT_SERVICE_LISTEN_HOST=127.0.0.1
BOT_SERVICE_LISTEN_PORT=8787
BOT_SERVICE_OUTBOX_ENABLED=true
BOT_SERVICE_OUTBOX_LIMIT=10
BOT_SERVICE_OUTBOX_LEASE_MS=60000
BOT_SERVICE_OUTBOX_POLL_MS=3000
BOT_SERVICE_OUTBOX_MAX_ATTEMPTS=5

BOT_SERVICE_PLATOON_BOT_USERNAME=your_platoon_bot
BOT_SERVICE_CLAUDE_BOT_USERNAME=your_claude_bot
BOT_SERVICE_CODEX_BOT_USERNAME=your_codex_bot
BOT_SERVICE_AUDITOR_BOT_USERNAME=your_auditor_bot

BOT_SERVICE_PLATOON_BOT_TOKEN=replace_with_platoon_bot_token
BOT_SERVICE_CLAUDE_BOT_TOKEN=replace_with_claude_bot_token
BOT_SERVICE_CODEX_BOT_TOKEN=replace_with_codex_bot_token
BOT_SERVICE_AUDITOR_BOT_TOKEN=replace_with_auditor_bot_token

BOT_SERVICE_PLATOON_WEBHOOK_SECRET=replace_with_platoon_webhook_secret
BOT_SERVICE_CLAUDE_WEBHOOK_SECRET=replace_with_claude_webhook_secret
BOT_SERVICE_CODEX_WEBHOOK_SECRET=replace_with_codex_webhook_secret
BOT_SERVICE_AUDITOR_WEBHOOK_SECRET=replace_with_auditor_webhook_secret

# Optional bot-service execution overrides. By default bot-service loads gateway/project roots from Supabase huai_gateway_instances.
# BOT_SERVICE_EXECUTION_GATEWAY_ID=primary
# BOT_SERVICE_EXECUTION_PROJECT_PATH=C:\Dev\HuAIChatroomSystem
BOT_SERVICE_EXECUTION_ACTOR_ROLE=codex_leader
BOT_SERVICE_EXECUTION_TIMEOUT_MS=900000

LOCAL_GATEWAY_ALLOWED_ROOTS=C:\Dev\HuAIChatroomSystem
LOCAL_GATEWAY_ALLOWED_ADAPTERS=codex,claude_code
LOCAL_GATEWAY_INTERVAL_MS=5000
LOCAL_GATEWAY_LIMIT=5
LOCAL_GATEWAY_MAX_ATTEMPTS=3
LOCAL_GATEWAY_LEASE_MS=960000
LOCAL_GATEWAY_MAX_RUNTIME_MS=900000
LOCAL_GATEWAY_MAX_CONSECUTIVE_ERRORS=5
LOCAL_GATEWAY_ALLOW_NETWORK=false
LOCAL_GATEWAY_HEALTH_PORT=8797
HUAI_AUTO_AUDIT_ENABLED=true
