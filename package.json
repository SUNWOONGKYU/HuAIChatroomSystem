{
  "name": "hu-ai-chatroom-system",
  "private": true,
  "version": "0.0.0",
  "description": "Telegram-based human-AI collaboration room orchestrator.",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "verify:structure": "node scripts/verify-structure.mjs",
    "verify:secrets": "node scripts/verify-no-secrets.mjs",
    "verify:outbox-consumer": "npm run build && node --test dist/apps/bot-service/test/outbox-consumer.test.js",
    "verify:local-gateway-consumer": "npm run build && node --test dist/apps/local-gateway/test/local-gateway-consumer.test.js",
    "verify:supabase-store": "npm run build && node --test dist/apps/bot-service/test/supabase-store.test.js dist/apps/bot-service/test/task-query-hydration.test.js",
    "verify:bot-service-runtime": "npm run build && node --test dist/apps/bot-service/test/runtime-selection.test.js",
    "verify:supabase-runtime-loader": "npm run build && node --test dist/apps/bot-service/test/supabase-runtime-loader.test.js",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "verify:local-gateway-supabase-store": "npm run build && node --test dist/apps/local-gateway/test/supabase-outbox-store.test.js",
    "verify:bot-token-resolver": "npm run build && node --test dist/apps/bot-service/test/bot-token-resolver.test.js",
    "verify:local-gateway-runtime": "npm run build && node --test dist/apps/local-gateway/test/runtime.test.js dist/apps/local-gateway/test/process-runner.test.js",
    "verify:telegram-fetch-sender": "npm run build && node --test dist/apps/bot-service/test/telegram-fetch-sender.test.js",
    "verify:operation-env": "node --test scripts/verify-operation-env.test.mjs",
    "verify:telegram-webhook-commands": "node --test scripts/generate-telegram-webhook-commands.test.mjs",
    "verify:bot-service-health": "npm run build && node --test dist/apps/bot-service/test/http-health.test.js",
    "verify:gate12": "npm run verify:supabase-store && npm run verify:local-gateway-supabase-store && npm run verify:outbox-consumer && npm run verify:telegram-fetch-sender && npm run verify:bot-token-resolver && npm run verify:bot-service-runtime",
    "verify:gate13": "npm run verify:operation-env",
    "verify:gate14": "npm run verify:telegram-webhook-commands",
    "verify:gate15": "npm run verify:bot-service-health",
    "verify:operation-ready": "node scripts/verify-operation-ready.mjs",
    "verify:all": "npm run verify:operation-ready",
    "verify:bot-service-webhook-e2e": "npm run build && node --test dist/apps/bot-service/test/http-webhook-e2e.test.js",
    "verify:gate17": "npm run verify:bot-service-webhook-e2e",
    "verify:supabase-room-seed": "node --test scripts/generate-supabase-room-seed.test.mjs",
    "verify:gate16": "npm run verify:supabase-room-seed",
    "verify:local-gateway-health": "npm run build && node --test dist/apps/local-gateway/test/health.test.js",
    "verify:gate18": "npm run verify:local-gateway-health",
    "verify:operation-runbook": "node --test scripts/verify-operation-runbook.test.mjs scripts/verify-doc-sync.mjs",
    "verify:gate19": "npm run verify:operation-runbook",
    "verify:gateway-result-ingestion": "npm run build && node --test dist/apps/local-gateway/test/gateway-result-ingestion.test.js",
    "verify:gate20": "npm run verify:gateway-result-ingestion && npm run verify:gateway-report-rendering && npm run verify:local-gateway-supabase-store && npm run verify:local-gateway-consumer",
    "verify:orchestrator-owner-flow": "npm run build && node --test dist/packages/orchestrator/test/owner-flow-outbox.test.js dist/packages/orchestrator/test/intent-router.test.js",
    "verify:gate21": "npm run verify:orchestrator-owner-flow && npm run verify:bot-service-webhook-e2e",
    "verify:task-state-transition": "npm run build && node --test dist/apps/bot-service/test/task-state-transition.test.js",
    "verify:gate22": "npm run verify:workflow && npm run verify:task-state-transition && npm run verify:supabase-store && npm run verify:orchestrator-owner-flow",
    "verify:callback-answer": "npm run build && node --test dist/packages/orchestrator/test/callback-answer-outbox.test.js dist/apps/bot-service/test/callback-answer-sender.test.js",
    "verify:gate23": "npm run verify:callback-answer && npm run verify:telegram-fetch-sender && npm run verify:orchestrator-owner-flow",
    "verify:doc-sync": "node --test scripts/verify-doc-sync.mjs",
    "verify:operation-checks": "node --test scripts/check-telegram-bots.test.mjs scripts/check-telegram-webhooks.test.mjs scripts/inspect-outbox.test.mjs scripts/repair-button-callback-outbox.test.mjs scripts/operation-status-report.test.mjs scripts/verify-operation-runbook.test.mjs scripts/verify-doc-sync.mjs",
    "verify:gate24": "npm run verify:operation-checks && npm run verify:telegram-bot-commands && npm run verify:telegram-bot-profiles && npm run verify:telegram-ui && npm run verify:secrets",
    "verify:telegram-webhook-apply": "node --test scripts/apply-telegram-webhooks.test.mjs",
    "verify:gate25": "npm run verify:telegram-webhook-apply && npm run verify:operation-checks && npm run verify:operation-ready-runner && npm run verify:secrets",
    "verify:operation-ready-runner": "node --test scripts/verify-operation-ready.test.mjs",
    "verify:telegram-id-discovery": "node --test scripts/discover-telegram-ids.test.mjs",
    "verify:gate26": "npm run verify:telegram-id-discovery && npm run verify:secrets",
    "verify:operation-env-template": "node --test scripts/verify-operation-env-template.test.mjs",
    "verify:gate27": "npm run verify:operation-env-template && npm run verify:operation-env && npm run verify:secrets",
    "verify:telegram-connection-sequence": "node --test scripts/telegram-connection-sequence.test.mjs",
    "verify:gate28": "npm run verify:telegram-connection-sequence && npm run verify:telegram-webhook-apply && npm run verify:telegram-id-discovery && npm run verify:secrets",
    "verify:service-startup-preflight": "node --test scripts/service-startup-preflight.test.mjs",
    "verify:gate29": "npm run verify:service-startup-preflight && npm run verify:operation-env && npm run verify:operation-env-loader && npm run verify:secrets",
    "verify:operation-env-loader": "node --test scripts/operation-env-loader.test.mjs",
    "verify:telegram-bot-commands": "node --test scripts/set-telegram-bot-commands.test.mjs",
    "verify:telegram-bot-command-check": "node --test scripts/set-telegram-bot-commands.test.mjs",
    "verify:telegram-bot-profiles": "node --test scripts/apply-telegram-bot-profile-photos.test.mjs",
    "apply:telegram-bot-profiles": "node scripts/apply-telegram-bot-profile-photos.mjs --apply",
    "verify:workflow": "npm run build && node --test dist/packages/workflow/test/state-machine.test.js",
    "verify:gateway-report-rendering": "npm run build && node --test dist/packages/supabase-runtime/test/gateway-report-rendering.test.js",
    "verify:telegram-ui": "npm run build && node --test dist/packages/telegram-ui/test/sanitize.test.js dist/packages/telegram-ui/test/callback-data-length.test.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "24.2.0",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "grammy": "^1.45.1"
  }
}
